{
  "expo": {
    "name": "School Booth",
    "slug": "school-booth",
    "owner": "devjomar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mobile",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "package": "com.devjomar.schoolbooth",
      "versionCode": 1,
      "icon": "./assets/images/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-adaptive-icon.png",
        "monochromeImage": "./assets/images/android-monochrome-icon.png",
        "backgroundColor": "#061A47"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061A47",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow School Booth to use your camera to take photobooth photos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow School Booth to save your finished photos.",
          "granularPermissions": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e02aac85-fd3e-4934-b12e-dace69bc1034"
      }
    }
  }
}
